{
	"schemaVersion": 1,
	"id": "gatherlist",
	"version": "${version}",
	"name": "Gatherlist",
	"description": "Material checklists for your builds. Make a list, gather, and always see what's still missing - in a small window and on your HUD. Counts your inventory, shulker boxes and every chest you open. Works on any server.",
	"authors": ["Ayri"],
	"contact": {
		"homepage": "https://github.com/darmixsuper-ai/pagoda-mod",
		"sources": "https://github.com/darmixsuper-ai/pagoda-mod",
		"issues": "https://github.com/darmixsuper-ai/pagoda-mod/issues"
	},
	"license": "MIT",
	"icon": "assets/gatherlist/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.gatherlist.GatherlistClient"]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
